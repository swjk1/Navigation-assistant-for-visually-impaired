    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild --platform android",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:watch": "node --test --watch \"test/**/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "verify": "npm run lint && npm run typecheck && npm test",
    "test:core": "cd navigation-core && ./gradlew test",
    "probe:gemini": "node scripts/probe-gemini-live.mjs",
    "probe:hybrid": "node scripts/probe-hybrid-pipeline.mjs",
    "profile:capture": "node scripts/profile-capture-timing.mjs",
    "profile:latency": "node scripts/profile-latency.mjs",
    "audit:security": "node scripts/security_audit.mjs",
    "report:prd": "node scripts/report-prd-alignment.mjs",
    "report:handoff": "node scripts/report-teammate-handoff.mjs",
    "report:verification": "node scripts/report-final-verification.mjs",
    "download:yolo26": "node scripts/download-yolo26.js",
    "reset-project": "node ./scripts/reset-project.js"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }

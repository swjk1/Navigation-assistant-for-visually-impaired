# Gemini API Credentials (DO NOT COMMIT THE ACTUAL KEY)
# Prefer GEMINI_API_KEY — it is not embedded in Expo public/web bundles.
# EXPO_PUBLIC_GEMINI_API_KEY works for quick Expo demos only (ships in the client).
GEMINI_API_KEY=your_gemini_api_key_here
# EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# "live" = real Gemini Flash calls | "mock" = offline fixtures only
PERCEPTION_MODE=live

# Optional override (default in code: gemini-3.6-flash; PRD's 2.0-flash was retired by Google)
# GEMINI_MODEL=gemini-3.6-flash

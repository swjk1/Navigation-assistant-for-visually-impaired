# Gemini API credentials. NEVER commit the real key - .gitignore blocks .env.
#
# Which name to use depends on WHERE the code runs, and the difference is not cosmetic:
#
#   GEMINI_API_KEY              Read by Node only: the offline tests and scripts/.
#                               Never compiled into an app bundle.
#
#   EXPO_PUBLIC_GEMINI_API_KEY  The only name Expo inlines into the client bundle, so it is the
#                               only one the app can find on a phone - and it is extractable
#                               from the built APK by anyone who has it. Fine for development
#                               and demos; not suitable for a release build.
#
# Shipping the cloud perception path to real users means putting the Gemini call behind a server
# that holds the key. Until then, treat that path as a development capability.
GEMINI_API_KEY=your_gemini_api_key_here
# EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# "live" = real Gemini Flash calls | "mock" = offline fixtures only
PERCEPTION_MODE=live

# Optional: the free tier often rate-limits gemini-3.6-flash after ~20 calls.
# Uncomment to prefer the rotating "latest" alias:
# GEMINI_MODEL=gemini-flash-latest

# ---------------------------------------------------------------------------------------------
# Navigation simulator (navigation-sim) - paid model baselines and advisers.
#
# Only the *_API_KEY lines are read from this file (navigation-sim looks in ../.env when the
# variable is not set in the environment). The run settings further down are read from the shell
# environment only - setting them here has no effect.

# OpenAI: the model baselines +b5 (Decisions API), +b3 and +b2 (generative chooser).
OPENAI_API_KEY=your_openai_api_key_here

# Older LLM adviser (design llm-advice): Anthropic, or Gemini via GEMINI_API_KEY above.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Shell-only run settings, for reference (export them before running the benchmark):
#   NAV_LLM_ALLOW=1           required for any live paid call; without it, cached replies only
#   NAV_LLM_DRY_RUN=1         send nothing; print the requests and tokens a run would use
#   LLM_BUDGET_USD=1.00       spend cap across runs (benchmarks/llm-cache/openai-spend.txt)
#   OPENAI_DECISIONS_MODEL    model for +b5 (default gpt-6-luna)
#   OPENAI_MODEL              model for +b3 / +b2 (no default; required for those)
#   OPENAI_PRICE_IN           USD per million input tokens for OPENAI_MODEL (required with it)
#   OPENAI_PRICE_OUT          USD per million output tokens for OPENAI_MODEL (required with it)
#   ANTHROPIC_MODEL, GEMINI_MODEL   adviser models for llm-advice

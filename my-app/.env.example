# Gemini API credentials. NEVER commit the real key - .gitignore blocks .env.
#
# Which name to use depends on WHERE the code runs, and the difference is not cosmetic:
#
#   GEMINI_API_KEY              Read by Node only: the offline tests and scripts/.
#                               Never compiled into an app bundle.
#
#   EXPO_PUBLIC_GEMINI_API_KEY  The only name Expo inlines into the client bundle, so it is the
#                               only one the app can find on a phone - and it is extractable
#                               from the built APK by anyone who has it. Fine for development
#                               and demos; not suitable for a release build.
#
# Shipping the cloud perception path to real users means putting the Gemini call behind a server
# that holds the key. Until then, treat that path as a development capability.
GEMINI_API_KEY=your_gemini_api_key_here
# EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# "live" = real Gemini Flash calls | "mock" = offline fixtures only
PERCEPTION_MODE=live

# Optional: the free tier often rate-limits gemini-3.6-flash after ~20 calls.
# Uncomment to prefer the rotating "latest" alias:
# GEMINI_MODEL=gemini-flash-latest
